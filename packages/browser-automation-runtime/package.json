{
  "name": "@kcml/browser-automation-runtime",
  "version": "2026.8.30-8",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@kcml/browser-interaction": "workspace:*",
    "@kcml/browser-runtime-contracts": "workspace:*",
    "@kcml/database": "workspace:*",
    "@kcml/domain": "workspace:*"
    ,"@kcml/schemas": "workspace:*",
    "playwright": "catalog:"
  }
}
