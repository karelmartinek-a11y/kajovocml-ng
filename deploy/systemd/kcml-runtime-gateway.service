[Unit]
Description=KájovoCML NG runtime gateway
Requires=kcml-runtime-gateway.socket kcml-platform-recovery.service
After=kcml-runtime-gateway.socket postgresql.service kcml-platform-recovery.service
PartOf=kcml.target

[Service]
Type=exec
User=kcml-runtime-gateway
Group=kcml-runtime-gateway
SupplementaryGroups=kcml-runtime-callers kcml-release-readers
WorkingDirectory=/opt/kajovocml-ng/current
EnvironmentFile=/etc/kajovocml-ng/runtime.env
LoadCredential=database-url:/etc/kajovocml-ng/credentials/kcml-runtime-gateway/database-url
Environment=KCML_DATABASE_URL_FILE=%d/database-url
Environment=NODE_ENV=production
Environment=KCML_SERVICE_NAME=kcml-runtime-gateway
ExecStart=/usr/bin/node /opt/kajovocml-ng/current/apps/runtime-gateway/dist/index.js
Restart=on-failure
RestartSec=2s
TimeoutStartSec=90s
TimeoutStopSec=45s
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/kajovocml-ng/current /etc/kajovocml-ng/runtime.env
ReadWritePaths=/var/lib/kajovocml-ng/runtime /run/kajovocml-ng/gateway
LimitNOFILE=32768
TasksMax=256
CPUQuota=200%
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kcml-runtime-gateway

[Install]
WantedBy=kcml.target
