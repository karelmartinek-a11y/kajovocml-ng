[Unit]
Description=KájovoCML NG runtime gateway socket

[Socket]
ListenStream=/run/kajovocml-ng/gateway/runtime-gateway.sock
FileDescriptorName=runtime-gateway
NonBlocking=yes
SocketUser=kcml-runtime-gateway
SocketGroup=kcml-runtime-callers
SocketMode=0660
DirectoryMode=0750
Accept=no
RemoveOnStop=yes
Service=kcml-runtime-gateway.service

[Install]
WantedBy=sockets.target