[Unit]
Description=KájovoCML NG verified scheduled backup
After=postgresql.service
[Service]
Type=oneshot
User=root
ExecStart=/opt/kajovocml-ng/current/deploy/scripts/backup-production.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kajovocml-ng/backups
